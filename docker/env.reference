# Every environment setting rizzy-harness reads. Copy what you need into the
# template's .env (or export it). Precedence:
#   process environment  >  .env  >  config.toml  >  built-in defaults
# `serve` loads ./.env from its working directory, or the file named by
# HARNESS_ENV_FILE (any command). compose.yaml passes .env into the
# container (env_file).
#
# Settings marked [config] also exist in config.toml. Given here they win at
# runtime, show read-only in the UI, and are written into config.toml only
# where it has no value yet; an existing config.toml value is never changed.
# The others are instance settings that only live in the environment.
# Every HARNESS_* variable, and every name a .env sets, is hidden from the
# agents' shell tools; secrets are also redacted from transcripts.

# ---- Instance ---------------------------------------------------------------
# HARNESS_DATA_DIR=/data                 data directory
# HARNESS_BIND=0.0.0.0:7777              serve --bind
# HARNESS_TLS=false                      serve --tls (self-signed HTTPS)
# HARNESS_INSECURE_BIND=false            serve --insecure-bind
# HARNESS_ALLOWED_HOSTS=a:7777,b:7777    extra Host/Origin values
# HARNESS_NODE_LISTEN=0.0.0.0:7443       accept remote worker nodes
# HARNESS_NO_LOCAL_NODE=true             no agentic node in this process
# HARNESS_LOG=info                       tracing filter
# HARNESS_PLAIN_HTTP_HOSTS=ollama,qdrant local hosts: plain http with a key, and
#                                        reachable by provider tests (add localhost
#                                        for an Ollama on this machine)

# ---- Default model and a first provider -------------------------------------
# HARNESS_DEFAULT_MODEL=openai::gpt-5.1-mini           [config] default_model
# Written into config.toml once, while it has no real provider:
# HARNESS_PROVIDER_PRESET=openai     a preset id (openai, ollama, custom_openai, ...)
# HARNESS_PROVIDER_ID=openai         model prefix (default: the preset id)
# HARNESS_PROVIDER_NAME=OpenAI
# HARNESS_PROVIDER_KIND=openai       openai | anthropic (custom presets)
# HARNESS_PROVIDER_BASE_URL=         required for custom presets
# HARNESS_PROVIDER_API_KEY=          referenced by name; never written to disk
# HARNESS_PROVIDER_MODELS=a,b        chat models to list

# ---- Memory ------------------------------------------------------------------
# HARNESS_MEMORY_BACKEND=builtin      [config] builtin | qdrant | mem0 | off
# HARNESS_MEMORY_RECALL=keywords      [config] keywords | meaning
# HARNESS_EMBEDDINGS_SOURCE=ollama    [config] provider | ollama
# HARNESS_EMBEDDINGS_PROVIDER=        [config] provider id (source = provider)
# HARNESS_EMBEDDINGS_URL=             [config] Ollama-style base URL
# HARNESS_EMBEDDINGS_MODEL=           [config]
# HARNESS_QDRANT_URL=http://qdrant:6333   [config] (backend = qdrant)
# HARNESS_QDRANT_COLLECTION=harness_memory [config] prefix; vector size appended
# HARNESS_QDRANT_API_KEY=
# HARNESS_MEM0_URL=                   [config] (backend = mem0)

# ---- Chat tools ----------------------------------------------------------------
# HARNESS_WEB_SEARCH=none             [config] none | searxng | brave
# HARNESS_SEARXNG_URL=                [config]
# HARNESS_VOICE_URL=                  [config] /audio/transcriptions endpoint
# HARNESS_VOICE_MODEL=                [config]

# ---- Remote nodes (on the node machine) ---------------------------------------
# HARNESS_JOIN_TOKEN=                 node join --token, kept out of the process list
