# Full template. Every HARNESS_* setting is documented in ../env.reference.
# compose.yaml already sets memory (Qdrant + Ollama embeddings) and Redis;
# those settings are read-only in the UI.

# Generate each with: openssl rand -hex 24
REDIS_PASSWORD=
QDRANT_API_KEY=
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# all-minilm (fast), nomic-embed-text (default), mxbai-embed-large (best).
# EMBEDDINGS_MODEL=nomic-embed-text

# HARNESS_TAG=latest
# HARNESS_PORT=7777

# SQLite in /data until the MariaDB port lands.
HARNESS_DATABASE_URL=sqlite://

# Shared by every harness process behind one address: openssl rand -hex 32
# HARNESS_JWT_SECRET=

# HARNESS_ALLOWED_HOSTS=harness.example.lan:7777

# A first AI provider (onboarding starts with it filled in).
# HARNESS_PROVIDER_PRESET=openai
# HARNESS_PROVIDER_API_KEY=
# HARNESS_PROVIDER_MODELS=gpt-5.1-mini

# Web search for chats (a SearXNG you run, JSON output enabled).
# HARNESS_WEB_SEARCH=searxng
# HARNESS_SEARXNG_URL=http://searxng:8080
