# Minimal template. Every HARNESS_* setting is documented in ../env.reference.
# Settings given here win over config.toml, are read-only in the UI, and are
# written into config.toml only where it has no value yet.

# HARNESS_TAG=latest
# HARNESS_PORT=7777
# HARNESS_DATA_PATH=./data

# Storage: SQLite in /data (chats, accounts, logins). Nothing to set.

# The host:port people type in the browser, when it is not 127.0.0.1/localhost.
# HARNESS_ALLOWED_HOSTS=harness.example.lan:7777

# A first AI provider (onboarding starts with it filled in).
# HARNESS_PROVIDER_PRESET=openai
# HARNESS_PROVIDER_API_KEY=
# HARNESS_PROVIDER_MODELS=gpt-5.1-mini
# HARNESS_DEFAULT_MODEL=openai::gpt-5.1-mini

# Memory: built-in (SQLite, keyword recall) by default.
# HARNESS_MEMORY_BACKEND=builtin
