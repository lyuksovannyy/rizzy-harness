# Standard template. Every HARNESS_* setting is documented in ../env.reference.

# Generate each with: openssl rand -hex 24
REDIS_PASSWORD=
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
# MARIADB_DATABASE=harness
# MARIADB_USER=harness

# HARNESS_TAG=latest
# HARNESS_PORT=7777

# SQLite in /data until the MariaDB port lands. Then:
# HARNESS_DATABASE_URL=mysql://harness:<MARIADB_PASSWORD>@mariadb:3306/harness
HARNESS_DATABASE_URL=sqlite://

# HARNESS_KV_URL is set by compose.yaml from REDIS_PASSWORD.

# Shared by every harness process behind one address: openssl rand -hex 32
# Unset: a random key in /data/keys/jwt.key (one process only).
# HARNESS_JWT_SECRET=

# HARNESS_ALLOWED_HOSTS=harness.example.lan:7777

# A first AI provider (onboarding starts with it filled in).
# HARNESS_PROVIDER_PRESET=openai
# HARNESS_PROVIDER_API_KEY=
# HARNESS_PROVIDER_MODELS=gpt-5.1-mini
