@@ -0,0 +1,125 @@
+//! GATE 3 REVIEW PROOFS (docs/security-review/2026-11-gate3.md), on the
+//! master's mirror (`Store::append`).
+//!
+//! Each test passes today, and passing is the defect: it asserts that the
+//! attack worked. Invert the assertions when the finding is fixed.
+
+use harness_core::{RawEvent, SessionId};
+use harness_store::{AppendOutcome, Store};
+use serde_json::{Value, json};
+
+fn ev(sid: SessionId, seq: u64, kind: &str, payload: Value) -> RawEvent {
+    RawEvent {
+        session_id: sid,
+        seq,
+        ts_ms: seq as i64,
+        kind: kind.into(),
+        payload,
+    }
+}
+
+fn created(title: &str, parent: Option<SessionId>) -> Value {
+    let mut p = json!({"title": title, "cwd": "/w", "model": "m", "backend": "native",
+        "node_id": "n1", "profile": "agentic", "approval_mode": "ask"});
+    if let Some(parent) = parent {
+        p["parent_session"] = json!(parent);
+    }
+    p
+}
+
+/// A chat on node `node`, created through the master by `owner`.
+fn chat(s: &Store, node: &str, owner: &str) -> SessionId {
+    let sid = SessionId::new();
+    assert_eq!(
+        s.append(node, &ev(sid, 1, "session_created", created("t", None)))
+            .unwrap(),
+        AppendOutcome::Applied
+    );
+    s.claim_session(sid, Some(owner), None).unwrap();
+    sid
+}
+
+/// L-2. `session_created` is applied at any `seq`, not only as a session's
+/// first event, and its `parent_session` decides the owner. A node that
+/// hosts chats of Alice and Bob sends a second `session_created` on Alice's
+/// chat that names Bob's chat as its parent: the master's mirror now says
+/// the chat is Bob's. Alice no longer sees it; Bob reads all of it through
+/// the master (`visible_session` compares `owner_id`).
+#[test]
+fn review_l2_a_node_moves_a_chat_to_another_user() {
+    let s = Store::open_in_memory().unwrap();
+    let alice = chat(&s, "n1", "alice");
+    let bob = chat(&s, "n1", "bob");
+    assert_eq!(
+        s.session(alice).unwrap().unwrap().owner_id.as_deref(),
+        Some("alice")
+    );
+    let out = s
+        .append(
+            "n1",
+            &ev(alice, 2, "session_created", created("t", Some(bob))),
+        )
+        .unwrap();
+    assert_eq!(out, AppendOutcome::Applied);
+    assert_eq!(
+        s.session(alice).unwrap().unwrap().owner_id.as_deref(),
+        Some("bob"),
+        "the chat changed owner on a node's word"
+    );
+    // With a parent the master does not know, the chat loses its owner:
+    // nobody but the API token sees it or can delete it.
+    let out = s
+        .append(
+            "n1",
+            &ev(
+                bob,
+                2,
+                "session_created",
+                created("t", Some(SessionId::new())),
+            ),
+        )
+        .unwrap();
+    assert_eq!(out, AppendOutcome::Applied);
+    assert_eq!(s.session(bob).unwrap().unwrap().owner_id, None);
+}
+
+/// L-1, the store half. `parent_session` is stored whatever it names: here
+/// a chat of another node and another user. `projects::project_of`
+/// (`crates/master/src/projects.rs`) then reads the project of that parent
+/// row, with no check of node or owner, and `Master::prompt` sends that
+/// project's instructions, board and recalled facts to this chat's node as
+/// `session.prompt.context`.
+#[test]
+fn review_l1_a_node_names_another_nodes_chat_as_its_parent() {
+    let s = Store::open_in_memory().unwrap();
+    let victim = chat(&s, "n-victim", "alice");
+    let sid = SessionId::new();
+    s.append(
+        "n-hostile",
+        &ev(sid, 1, "session_created", created("t", Some(victim))),
+    )
+    .unwrap();
+    // What `Master::create_session` does after the node's ack.
+    s.claim_session(sid, Some("mallory"), None).unwrap();
+    let row = s.session(sid).unwrap().unwrap();
+    assert_eq!(row.owner_id.as_deref(), Some("mallory"));
+    assert_eq!(row.parent_id, Some(victim.to_string()));
+}
+
+/// L-3. Nothing caps what a node's `session_created` puts into the
+/// `sessions` row: a title of several megabytes is stored as it is, and
+/// every listing (`Store::sessions`, read whole by `GET /api/sessions`,
+/// the project pages and the revocation sweep) loads it for every user.
+#[test]
+fn review_l3_a_nodes_session_title_is_stored_without_a_limit() {
+    let s = Store::open_in_memory().unwrap();
+    let big = "A".repeat(4 << 20);
+    for _ in 0..3 {
+        let sid = SessionId::new();
+        s.append("n1", &ev(sid, 1, "session_created", created(&big, None)))
+            .unwrap();
+    }
+    let rows = s.sessions().unwrap();
+    let bytes: usize = rows.iter().map(|r| r.title.len()).sum();
+    assert_eq!(bytes, 3 * (4 << 20), "every listing carries all of it");
+}
