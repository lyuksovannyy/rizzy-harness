+++ b/crates/cli/tests/support/review_t8a/kill_window.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""T.8a review, T8A-2: how long after a spawn does killing the node, or
+bubblewrap's process group, leave the namespace running?
+
+    kill_window.py node  <delay-us>...   SIGKILL to the spawning process (the
+                                         node) <delay> after its spawn returned
+    kill_window.py group <delay-us>...   SIGKILL to bubblewrap's process group
+                                         (KillGroupOnDrop, kill_on_drop)
+
+Each delay is tried REPS times (default 40). The command line is the node's
+(`--die-with-parent --new-session --unshare-pid --dev-bind / / --proc /proc`)
+running `sleep <n>`; survivors are found by that command line 1.5 s later and
+killed by pid, with the bwrap init that is their parent. Writes no file.
+"""
+import os, signal, subprocess, sys, time
+REPS = int(os.environ.get("REPS", "40"))
+D = os.path.dirname(os.path.abspath(__file__))
+SECS = 976700 + (os.getpid() % 90)
+
+def sleeps():
+    want = b"sleep\0%d\0" % SECS
+    out = []
+    for p in os.listdir("/proc"):
+        if p.isdigit():
+            try:
+                if open(f"/proc/{p}/cmdline", "rb").read() == want:
+                    st = open(f"/proc/{p}/stat").read().rsplit(")", 1)[1].split()[0]
+                    if st not in "ZXx":
+                        out.append(int(p))
+            except OSError:
+                pass
+    return out
+
+def bwrap_argv():
+    return ["bwrap", "--die-with-parent", "--new-session", "--unshare-pid",
+            "--dev-bind", "/", "/", "--proc", "/proc", "--chdir", D, "--",
+            "sleep", str(SECS)]
+
+def busy_wait(us):
+    end = time.perf_counter() + us / 1e6
+    while time.perf_counter() < end:
+        pass
+
+def one(mode, us):
+    if mode == "group":
+        p = subprocess.Popen(bwrap_argv(), process_group=0,
+                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                             stderr=subprocess.DEVNULL)
+        busy_wait(us)
+        try: os.killpg(p.pid, signal.SIGKILL)
+        except ProcessLookupError: pass
+        p.wait()
+    else:
+        r, w = os.pipe()
+        node = os.fork()
+        if node == 0:
+            os.close(r)
+            p = subprocess.Popen(bwrap_argv(), process_group=0,
+                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                                 stderr=subprocess.DEVNULL)
+            os.write(w, b"x")
+            time.sleep(1000)
+            os._exit(0)
+        os.close(w)
+        os.read(r, 1); os.close(r)
+        busy_wait(us)
+        os.kill(node, signal.SIGKILL)
+        os.waitpid(node, 0)
+    # anything still alive 1.5 s later survived its killer
+    time.sleep(0.05)
+    by = time.time() + 1.5
+    left = sleeps()
+    while left and time.time() < by:
+        time.sleep(0.05); left = sleeps()
+    for pid in left:
+        # the survivor: kill the sleep itself and its namespace init (its parent)
+        try:
+            ppid = int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[1])
+        except OSError:
+            ppid = 0
+        for q in (pid, ppid):
+            if q > 1:
+                try:
+                    if q == pid or b"bwrap" in open(f"/proc/{q}/cmdline", "rb").read():
+                        os.kill(q, signal.SIGKILL)
+                except OSError: pass
+    return bool(left)
+
+mode = sys.argv[1]
+for us in map(int, sys.argv[2:]):
+    n = sum(one(mode, us) for _ in range(REPS))
+    print(f"{mode}: kill {us:>6} us after spawn: {n}/{REPS} namespaces survived", flush=True)
diff --git a/crates/cli/tests/support/review_t8a/landlock_abi4.py b/crates/cli/tests/support/review_t8a/landlock_abi4.py
new file mode 100755
index 0000000..801cb47
--- /dev/null
+++ b/crates/cli/tests/support/review_t8a/landlock_abi4.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""T.8a review: a stand-in for `rizzy-harness sandbox-exec` on a kernel with
+Landlock ABI 4 (Ubuntu 24.04's 6.8, the kernel README.md names).
+
+It takes the wrapper's arguments (`--rw <expect> <path>`, `--ro <expect>
+<path>`, `-- <command>`), applies the rights such a kernel has (the
+filesystem rights of ABI 1 to 3; no device-ioctl right, no abstract-socket or
+signal scope, no pathname-socket right), sets `no_new_privs` and execs the
+command. The real wrapper asks for the newer rights best-effort
+(`crates/tools/src/sandbox.rs`, `imp::restrict`), so on such a kernel this is
+what it enforces. Identities are not checked here: the proofs that use this
+do not swap folders.
+"""
+import ctypes
+import os
+import sys
+
+libc = ctypes.CDLL(None, use_errno=True)
+FS_ABI3 = (1 << 15) - 1  # LANDLOCK_ACCESS_FS_EXECUTE .. _TRUNCATE
+FS_FILE = (1 << 0) | (1 << 1) | (1 << 2) | (1 << 14)  # execute, write, read, truncate
+FS_READ = (1 << 0) | (1 << 2) | (1 << 3)  # execute, read file, read dir
+
+
+def check(ok, what):
+    if not ok:
+        sys.exit(f"landlock_abi4.py: {what}: {os.strerror(ctypes.get_errno())}")
+
+
+args = sys.argv[1:]
+rules, i = [], 0
+while args[i] != "--":
+    if args[i] in ("--rw", "--ro"):
+        rules.append((args[i], args[i + 2]))
+        i += 3
+    else:
+        i += 1
+command = args[i + 1:]
+
+handled = ctypes.c_uint64(FS_ABI3)  # struct landlock_ruleset_attr, first field only
+ruleset = libc.syscall(444, ctypes.byref(handled), ctypes.c_size_t(8), 0)
+check(ruleset >= 0, "landlock_create_ruleset")
+for kind, path in rules:
+    try:
+        fd = os.open(path, os.O_PATH | os.O_CLOEXEC)
+    except FileNotFoundError:
+        continue
+    access = FS_ABI3 if kind == "--rw" else FS_READ
+    if not os.path.isdir(path):
+        access &= FS_FILE
+    # struct landlock_path_beneath_attr { __u64 allowed_access; __s32 parent_fd; } packed
+    attr = access.to_bytes(8, "little") + fd.to_bytes(4, "little", signed=True)
+    check(libc.syscall(445, ruleset, 1, attr, 0) == 0, f"landlock_add_rule {path}")
+check(libc.prctl(38, 1, 0, 0, 0) == 0, "no_new_privs")
+check(libc.syscall(446, ruleset, 0) == 0, "landlock_restrict_self")
+os.execvp(command[0], command)
diff --git a/crates/cli/tests/support/review_t8a/session_bus.sh b/crates/cli/tests/support/review_t8a/session_bus.sh
new file mode 100755
index 0000000..d3e607e
--- /dev/null
+++ b/crates/cli/tests/support/review_t8a/session_bus.sh
@@ -0,0 +1,48 @@
+#!/bin/bash
+# T.8a review, T8A-1 on a real session bus: one StartTransientUnit call from
+# inside a contained command (what `systemd-run --user` sends; systemd's own
+# client refuses to talk from a PID namespace, `gdbus` and libdbus do not),
+# then the node's kill (SIGKILL to bubblewrap).
+#
+#   session_bus.sh                      the wrapper as a kernel with Landlock
+#                                       ABI 4 enforces it (landlock_abi4.py)
+#   session_bus.sh <rizzy-harness>      the real wrapper on this kernel
+#
+# Needs bwrap, gdbus, python3 and a systemd user session. It starts one
+# transient unit `rizzy-review-t8a-<pid>` and stops it at the end; scratch
+# files go to a folder under $TMPDIR that it removes.
+set -u
+HERE=$(cd "$(dirname "$0")" && pwd)
+D=$(mktemp -d); trap 'rm -rf "$D"' EXIT
+WS=$D/ws; TMP=$D/tmp; mkdir -p "$WS" "$TMP"; echo SECRET > "$D/secret"
+U=rizzy-review-t8a-$$; N=$((975200 + $$ % 90)); UID_=$(id -u)
+ident() { stat -c '%d:%i' "$1"; }
+if [ $# -ge 1 ]; then wrapper=("$1" sandbox-exec); else wrapper=(python3 -I "$HERE/landlock_abi4.py"); fi
+# The node's command line (crates/tools/src/contain.rs, sandbox.rs `wrapper`).
+cmd=(bwrap --die-with-parent --new-session --unshare-pid --dev-bind / / --proc /proc --chdir "$WS" --
+     "${wrapper[@]}"
+     --rw "$(ident "$WS"):the session's folder" "$WS" --rw "$(ident "$TMP"):the session's temp folder" "$TMP")
+for d in /dev/null /dev/zero /dev/full /dev/random /dev/urandom; do cmd+=(--rw system $d); done
+for d in /usr /bin /sbin /lib /lib32 /lib64 /libx32 /etc /opt /proc; do [ -e $d ] && cmd+=(--ro system $d); done
+script="export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UID_/bus
+cat $D/secret 2>&1
+gdbus call --session --dest org.freedesktop.systemd1 --object-path /org/freedesktop/systemd1 \
+  --method org.freedesktop.systemd1.Manager.StartTransientUnit $U.service fail \
+  \"[('ExecStart', <[('/bin/sh', ['/bin/sh', '-c', 'cat $D/secret > $D/leak; exec sleep $N'], false)]>)]\" '[]' 2>&1
+echo StartTransientUnit rc=\$?
+setsid sleep $((N + 1)) & sleep $((N + 2))"
+(cd "$WS" && exec env -i PATH="$PATH" HOME="$HOME" TMPDIR="$TMP" setsid "${cmd[@]}" -- bash -c "$script") 2>&1 | grep -v bashrc &
+sleep 2
+BW=$(pgrep -n -f "^bwrap .*sleep $((N + 2))")
+inside() { echo "$(pgrep -f "^sleep $((N + 1))\$" | wc -l) setsid child, $(pgrep -f "^sleep $((N + 2))\$" | wc -l) foreground"; }
+echo "before the kill: inside the namespace: $(inside); the unit: $(systemctl --user is-active $U)"
+kill -KILL -- "-$BW"
+sleep 2
+echo "after the kill:  inside the namespace: $(inside); the unit: $(systemctl --user is-active $U)"
+P=$(systemctl --user show -p MainPID --value $U)
+if [ "${P:-0}" != 0 ]; then
+  echo "  the unit's process $P: $(tr '\0' ' ' < /proc/$P/cmdline)"
+  echo "  pid namespace $(readlink /proc/$P/ns/pid), the host's is $(readlink /proc/self/ns/pid); $(grep NoNewPrivs /proc/$P/status | tr '\t' ' ')"
+  echo "  it copied a file from outside the session folder: $(cat "$D/leak" 2>&1)"
+fi
+systemctl --user stop $U 2>/dev/null; echo "cleaned up: the unit is $(systemctl --user is-active $U)"
