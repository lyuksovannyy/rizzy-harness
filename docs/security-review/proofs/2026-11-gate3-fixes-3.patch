+//! GATE 3 FIX REVIEW 3 (docs/security-review/2026-11-gate3-fixes-3.md),
+//! against branch `fix/R.1-sandbox-findings` at `f1f9fd3`.
+//!
+//! The test passes on that branch, and passing is the defect. Invert the
+//! assertion when the finding is fixed.
+
+use super::*;
+
+/// R1b-1. A restore (an undo, and the automatic apply of a sub-agent's
+/// result) now reads every blob it will write into the node's memory before
+/// it writes the first one (`blob_contents`, then `at::Top::write`). The
+/// "groups of at most 64 MiB" bound one `cat-file --batch` call, not what
+/// is held: every group's content stays in the returned map, and a blob
+/// larger than a group goes whole. Before the rework `git checkout-index`
+/// wrote the files itself and the node held none of it.
+///
+/// Two files of 80 MiB each (sparse, so they cost the session no disk and
+/// a few kilobytes in the checkpoint store): the node holds all 160 MiB at
+/// once. Nothing bounds the total; a sub-agent's result of a few sparse
+/// gigabytes is applied without anyone clicking anything.
+#[tokio::test]
+async fn review_r1b_1_a_restore_holds_every_blob_it_writes_in_memory() {
+    const EACH: u64 = 80 << 20;
+    let d = tempfile::tempdir().unwrap();
+    let top = d.path().canonicalize().unwrap();
+    let ws = top.join("ws");
+    std::fs::create_dir(&ws).unwrap();
+    for name in ["big1", "big2"] {
+        let f = std::fs::File::create(ws.join(name)).unwrap();
+        f.set_len(EACH).unwrap();
+        // Different content, so they are two blobs.
+        std::os::unix::fs::FileExt::write_all_at(&f, name.as_bytes(), 0).unwrap();
+    }
+    let repo = repo_for(&ws, Some(&top.join("data/checkpoints")))
+        .await
+        .unwrap();
+    let snap = snapshot(&repo, "refs/harness/s/t/after", "after")
+        .await
+        .unwrap();
+    let mut writes = Vec::new();
+    for name in ["big1", "big2"] {
+        let id = run(&repo, &["rev-parse", &format!("{snap}:{name}")], None)
+            .await
+            .unwrap();
+        writes.push(("100644".to_string(), id, name.as_bytes().to_vec()));
+    }
+    let held = blob_contents(&repo, &writes).await.unwrap();
+    let total: u64 = held.values().map(|b| b.len() as u64).sum();
+    assert_eq!(held.len(), 2);
+    assert_eq!(
+        total,
+        2 * EACH,
+        "every byte of both files is in the node's memory at once"
+    );
+}
