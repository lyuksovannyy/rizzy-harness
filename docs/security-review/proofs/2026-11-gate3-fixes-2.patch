@@ -565,3 +565,62 @@ async fn a_socket_must_present_its_key_first() {
     }
     assert!(kinds.iter().any(|k| k == "approval_requested"), "{kinds:?}");
 }
+
+/// GATE 3 FIX REVIEW PROOF (R2-1). Passes on `fix/R.2-approval-findings`,
+/// and passing is the defect: invert the assertions when it is fixed.
+///
+/// The cookie alone is not worth nothing. A WebSocket upgrade is accepted
+/// on the cookie (the key comes later), and the socket takes one of the
+/// person's eight places (`Sockets::register`) before the key was seen,
+/// for up to `KEY_WAIT`. A client that holds only the cookie (the agent's
+/// own server on another port) keeps all eight taken, and the person's own
+/// page, key and all, is refused its live connection with 429: no events,
+/// no approval cards arriving. The upgrade's status also tells such a
+/// client whether the cookie is a live login (101 or 429 against 401), as
+/// `/api/favicon` does.
+#[tokio::test]
+async fn review_r2_1_a_cookie_alone_takes_every_socket_place() {
+    let t = start().await;
+    let alex = claim(&t).await;
+    // Eight sockets on the cookie alone; none ever sends a key.
+    let mut held = Vec::new();
+    for _ in 0..8 {
+        held.push(open_socket(&t, &alex.cookie).await);
+    }
+    // The person's own page now: cookie and key, as live.ts sends them.
+    let mut r = format!("ws://{}/api/ws", t.addr)
+        .into_client_request()
+        .unwrap();
+    r.headers_mut()
+        .insert("cookie", alex.cookie.parse().unwrap());
+    r.headers_mut()
+        .insert("origin", format!("http://{}", t.addr).parse().unwrap());
+    let refused = tokio_tungstenite::connect_async(r).await.unwrap_err();
+    let tokio_tungstenite::tungstenite::Error::Http(resp) = refused else {
+        panic!("not an HTTP refusal: {refused:?}");
+    };
+    assert_eq!(resp.status().as_u16(), 429, "the person's page is locked out");
+    drop(held);
+
+    // The cookie's validity is readable without the key, twice over.
+    let http = reqwest::Client::new();
+    let favicon = |cookie: Option<String>| {
+        let mut q = http.get(format!("{}/api/favicon?url=not-a-url", t.base));
+        if let Some(c) = cookie {
+            q = q.header("cookie", c);
+        }
+        async move { q.send().await.unwrap().status() }
+    };
+    assert_eq!(favicon(None).await, StatusCode::UNAUTHORIZED);
+    let dead = format!(
+        "{}={}",
+        alex.cookie.split('=').next().unwrap(),
+        "0".repeat(64)
+    );
+    assert_eq!(favicon(Some(dead)).await, StatusCode::UNAUTHORIZED);
+    assert_eq!(
+        favicon(Some(alex.cookie.clone())).await,
+        StatusCode::BAD_REQUEST,
+        "a live cookie without its key gets past the login check"
+    );
+}
